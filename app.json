{
  "expo": {
    "name": "Portfolio Tracker",
    "slug": "portfolio-tracker-rn",
    "version": "2.2.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "description": "Track your investment portfolio with gold, silver, and currency assets. Modern glassmorphism design with multi-language support.",
    "githubUrl": "https://github.com/esatakpunar/portfolio-tracker-rn",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f172a"
    },
    "ios": {
      "supportsTablet": true,
      "deploymentTarget": "16.4",
      "bundleIdentifier": "com.portfoliotracker.app",
      "buildNumber": "16",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "LSRequiresIPhoneOS": true,
        "UIRequiredDeviceCapabilities": [
          "armv7"
        ],
        "UIStatusBarStyle": "UIStatusBarStyleLightContent",
        "UIViewControllerBasedStatusBarAppearance": false
      },
      "config": {
        "usesNonExemptEncryption": false
      },
      "associatedDomains": [],
      "entitlements": {
        "com.apple.developer.applesignin": [],
        "com.apple.security.application-groups": ["group.com.portfoliotracker.app"]
      },
      "appleTeamId": "ZJUV6ZYP44"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0f172a"
      },
      "package": "com.portfoliotracker.app",
      "versionCode": 3,
      "permissions": []
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-localization",
      "expo-sqlite",
      "@react-native-community/datetimepicker",
      "expo-sharing",
      "expo-status-bar",
      [
        "expo-widgets",
        {
          "groupIdentifier": "group.com.portfoliotracker.app",
          "bundleIdentifier": "com.portfoliotracker.app.widgets",
          "enablePushNotifications": false,
          "widgets": [
            {
              "name": "PortfolioTotalWidget",
              "displayName": "Portfolio Tracker",
              "description": "Toplam portföy değeri (TL)",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium",
                  "systemLarge"
                ],
                "contentMarginsDisabled": true,
                "initialLayout": "./src/widgets/PortfolioTotalWidget.tsx"
              }
            }
          ]
        }
      ],
      "./plugins/withStripWidgetPushEntitlement.js"
    ],
    "extra": {
      "eas": {
        "projectId": "9eb1b6a0-cc19-45d1-a6ae-4b90c88a092f"
      }
    },
    "owner": "esatakpunar"
  }
}
